# Public, build-time configuration only (blueprint §9.3).
# Never put secrets, AWS keys, account IDs or a Cognito client secret here.
VITE_APP_MODE_DEFAULT=demo
# Live AWS Mode: public values from `terraform output` in
# infrastructure/environments/control-plane-dev (put them in .env.local, gitignored).
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Host only, e.g. opsentra-dev-abc123.auth.ap-southeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
